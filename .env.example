# Plantilla de Configuración de la Base de Datos PostgreSQL
# Copia este archivo con el nombre '.env' y escribe tus credenciales reales
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=register_db

# Configuración de Flask
FLASK_ENV=development
SECRET_KEY=cambiar_por_una_clave_aleatoria_y_segura

# Servicio de Correo Electrónico (Opciones: console, smtp, sendgrid)
EMAIL_PROVIDER=console

# Credenciales para SMTP (ej. Mailtrap, Gmail)
SMTP_SERVER=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=tu_usuario_smtp
SMTP_PASSWORD=tu_contrasena_smtp
SMTP_SENDER=noreply@sistemaextensible.com

# Credenciales para Nuevo Proveedor (ej. Sendgrid)
SENDGRID_API_KEY=SG.tu_api_key_aqui

