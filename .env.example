# Plantilla de Configuración de la Base de Datos (Opciones: mysql, postgres)
# Copia este archivo con el nombre '.env' y escribe tus credenciales reales
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=register_db

# Configuración de Flask
FLASK_ENV=development
SECRET_KEY=cambiar_por_una_clave_aleatoria_y_segura

# Servicio de Correo Electrónico (Opciones: console, smtp, gmail, sendgrid)
EMAIL_PROVIDER=smtp

# Credenciales para Gmail SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
# IMPORTANTE GMAIL: Requiere una Contraseña de Aplicación de 16 caracteres generada en tu cuenta de Google
SMTP_PASSWORD=tu_contrasena_de_aplicacion_aqui
SMTP_SENDER=tu_correo@gmail.com

# Credenciales para Nuevo Proveedor (ej. Sendgrid)
SENDGRID_API_KEY=SG.tu_api_key_aqui

